# User Input Handling
name = input("Enter your name: ")
age = int(input("Enter your age: "))

# Variables and Data Types
college = "ABC College"    # String
cgpa = 8.5                # Float
is_student = True         # Boolean

# Operators
next_age = age + 1

# Conditional Statements
if age >= 18:
    status = "Eligible to Vote"
else:
    status = "Not Eligible to Vote"

# Output
print("\n--- Student Details ---")
print("Name:", name)
print("Age:", age)
print("College:", college)
print("CGPA:", cgpa)
print("Student:", is_student)
print("Next Year Age:", next_age)
print("Voting Status:", status)

# Loops
print("\nNumbers from 1 to 5:")
for i in range(1, 6):
    print(i)

print("\nCountdown:")
count = 5
while count > 0:
    print(count)
    count -= 1

print("Program Completed!")